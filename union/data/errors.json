    "pkg03": {
      "title": "Error & Distribution Analysis: Weighted_Xentropy",
      "doc": "Boss_Union_Almost_Full_Weighted_Xentropy_Error_Analysis.md",
      "note": "Loss Function Quirk (Sample-Weighted Cross-Entropy):: This package trained the models using Cross-Entropy loss while applying continuous sample weights based on the true target. A target of `0.0` was assigned a weight of `100.0`, while a target of `1.0` was assigned a weight of `2.5` (a 40:1 ratio), forcing the models to prioritize minimizing False Positives (predicting a bad user when they are actually good).",
      "panels": [
        {
          "alt": "Distributions",
          "src": "error_img/Boss_Union_Almost_Full_Weighted_Xentropy_Error_Analysis_WeightedEnsemble_L4_dist_1791227183.png"
